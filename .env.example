# Copy to .env and fill in. NEVER commit .env.

# SEC EDGAR fair-access rule: identify yourself (name + email). Required from Stage 1.
SEC_USER_AGENT="Your Name your.email@example.com"

# LLM provider: anthropic | openai  (decided in DECISIONS.md D-003)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cheap model for development, stronger model for final runs (filled in Stage 4)
LLM_MODEL_DEV=
LLM_MODEL_FINAL=
